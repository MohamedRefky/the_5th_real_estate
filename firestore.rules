rules_version = '2';

// ─── Firestore Security Rules — The 5th Real Estate ─────────────────
//
// The public website renders from bundled local data, so Firestore is used
// ONLY by the hidden admin dashboard. Every read and write below is locked to
// the single admin UID.
//
// If you later move the public site onto Firestore, add a public read rule
// that only exposes `isPublished == true` documents — never loosen writes.
//
// IMPORTANT: These rules are the ONLY real security boundary — there is no
// backend server. Replace the admin UID placeholder (see FIREBASE_SETUP.md).

service cloud.firestore {
  match /databases/{database}/documents {

    match /properties/{propertyId} {
      // Admin-only access to the properties collection.
      allow read, write: if isAdmin();
    }

    // If the public site moves to Firestore later, add e.g.:
    //   match /properties/{propertyId} {
    //     allow get, list: if resource.data.isPublished == true;
    //     allow write: if isAdmin();
    //   }

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'yC5VCHMzFqWfNPaj1krkXZHAQ0D2';
    }
  }
}
