rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email != null && (
        request.auth.token.email.lower() == 'mohamedrifky9765@gmail.com' ||
        request.auth.token.email.lower() == 'mohamedeldamen342@gmail.com' ||
        request.auth.token.email.lower() == 'badeaakarat@gmail.com'
      );
    }
  }
}
